# NetSentinel AI Environment Configuration
APP_ENV=development
APP_NAME=NetSentinel AI
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/netsentinel

# Redis (Celery broker, cache, rate limiting)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Object Storage (S3-compatible / MinIO)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=netsentinel-data
S3_REGION=us-east-1
LOCAL_STORAGE_DIR=./data/storage

# Authentication & Security
JWT_SECRET_KEY=change-me-to-a-32-byte-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_PCAP_SIZE_MB=500

# LLM Provider Abstraction (gemini | openai_compatible | mock)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=25

# RAG Embeddings & Reranker
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
RERANKER_MODEL=BAAI/bge-reranker-base
USE_LOCAL_HASH_EMBEDDER=false

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Frontend
VITE_API_BASE_URL=/api/v1
